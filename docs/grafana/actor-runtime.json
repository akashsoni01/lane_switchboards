{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "ALERTS{alertname=~\"Lane.*\"}",
        "iconColor": "red",
        "name": "Lane alerts",
        "tagKeys": "alertname,severity",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "resilient_monitor runbook",
      "type": "link",
      "url": "https://github.com/didl/lane_switchboards/blob/main/examples/resilient_monitor.md",
      "targetBlank": true
    },
    {
      "title": "handle_timeout runbook",
      "type": "link",
      "url": "https://github.com/didl/lane_switchboards/blob/main/examples/handle_timeout_calculator_timer.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(lane_actor_messages_handled_total[5m]))",
          "legendFormat": "messages/sec",
          "refId": "A"
        }
      ],
      "title": "Actor message rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(lane_actor_handle_errors_total[5m]) + rate(lane_actor_panics_total[5m]) + rate(lane_actor_handle_timeouts_total[5m])) / clamp_min(sum(rate(lane_actor_messages_handled_total[5m])), 1e-9)",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "title": "Handle error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(lane_actor_handle_duration_seconds_bucket[5m])) by (le, actor_name))",
          "legendFormat": "p50 {{actor_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(lane_actor_handle_duration_seconds_bucket[5m])) by (le, actor_name))",
          "legendFormat": "p95 {{actor_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(lane_actor_handle_duration_seconds_bucket[5m])) by (le, actor_name))",
          "legendFormat": "p99 {{actor_name}}",
          "refId": "C"
        }
      ],
      "title": "Handle latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(lane_actor_in_flight) by (actor_name)",
          "legendFormat": "{{actor_name}}",
          "refId": "A"
        }
      ],
      "title": "In-flight handles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "lane_actor_mailbox_depth / clamp_min(lane_actor_mailbox_capacity, 1)",
          "legendFormat": "{{actor_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1 },
        "overrides": []
      },
      "title": "Mailbox depth % of capacity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lane_actor_mailbox_wait_seconds_bucket[5m])) by (le, actor_name))",
          "legendFormat": "p95 {{actor_name}}",
          "refId": "A"
        }
      ],
      "title": "Mailbox wait p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(increase(lane_actor_handle_timeouts_total[$__range]))",
          "legendFormat": "timeouts (range)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(lane_actor_panics_total[$__range]))",
          "legendFormat": "panics (range)",
          "refId": "B"
        },
        {
          "expr": "sum(increase(lane_actor_slow_handles_total[$__range]))",
          "legendFormat": "slow (range)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(lane_actor_panics_total[$__rate_interval]))",
          "legendFormat": "panics/sec",
          "refId": "D"
        }
      ],
      "title": "Failures & slow handles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(lane_supervisor_restarts_total[15m])) by (child)",
          "legendFormat": "{{child}}",
          "refId": "A"
        }
      ],
      "title": "Supervisor restarts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 7,
      "targets": [
        {
          "expr": "lane_supervisor_restart_intensity_remaining",
          "legendFormat": "remaining",
          "refId": "A"
        },
        {
          "expr": "lane_supervisor_children_alive",
          "legendFormat": "children alive",
          "refId": "B"
        }
      ],
      "title": "Supervisor health",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 10,
      "targets": [
        {
          "expr": "sum(increase(lane_actor_exits_total[1h])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "right" } },
      "title": "Exit reasons (1h)",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(lane_mesh_dispatches_total[5m])) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Mesh dispatch rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(lane_consistency_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "p95 {{service}}",
          "refId": "A"
        }
      ],
      "title": "Consistency op latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 13,
      "targets": [
        {
          "expr": "sum(rate(lane_storage_quorum_failures_total[5m]))",
          "legendFormat": "quorum failures/sec",
          "refId": "A"
        },
        {
          "expr": "rate(lane_storage_wal_bytes_written_total[5m])",
          "legendFormat": "WAL bytes/sec",
          "refId": "B"
        }
      ],
      "title": "Storage quorum & WAL",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["lane", "actors"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Lane Actor Runtime",
  "uid": "lane-actor-runtime",
  "version": 2
}
